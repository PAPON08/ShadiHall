@model ShadiHall.ViewModels.HallFormViewModel
@{
    ViewData["Title"] = Model.HallId == 0 ? "Add New Hall" : "Edit Hall";
    bool isEdit = Model.HallId != 0;
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <div class="dash-profile"><div class="dash-avatar">A</div><div class="dash-profile-info"><strong>Administrator</strong></div></div>
        <nav class="dash-nav">
            <a asp-controller="Admin" asp-action="Index" class="dash-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Halls" class="dash-nav-link active"><i class="fas fa-building"></i> Manage Halls</a>
            <a asp-controller="Admin" asp-action="Reservations" class="dash-nav-link"><i class="fas fa-calendar-check"></i> Reservations</a>
            <a asp-controller="Admin" asp-action="Users" class="dash-nav-link"><i class="fas fa-users"></i> Users</a>
            <a asp-controller="Admin" asp-action="Messages" class="dash-nav-link"><i class="fas fa-envelope"></i> Messages</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dash-page-header">
            <h1>@(isEdit ? "Edit Hall" : "Add New Hall")</h1>
            <a asp-action="Halls" class="btn-outline-sm">← Back</a>
        </div>
        <div class="form-card">
            <form asp-action="@(isEdit ? "EditHall" : "CreateHall")" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                @if (isEdit) { <input type="hidden" asp-for="HallId" /> }
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-input" placeholder="Hall name" />
                        <span asp-validation-for="Name" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Location" class="form-label"></label>
                        <input asp-for="Location" class="form-input" placeholder="e.g. Main Building, Ground Floor" />
                        <span asp-validation-for="Location" class="field-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="ShortDescription" class="form-label"></label>
                    <input asp-for="ShortDescription" class="form-input" placeholder="Brief summary (shown on card)" />
                    <span asp-validation-for="ShortDescription" class="field-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-input" rows="5" placeholder="Full description of the hall..."></textarea>
                    <span asp-validation-for="Description" class="field-error"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="PricePerDay" class="form-label"></label>
                        <input asp-for="PricePerDay" type="number" class="form-input" placeholder="e.g. 100000" />
                        <span asp-validation-for="PricePerDay" class="field-error"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="Capacity" class="form-label"></label>
                        <input asp-for="Capacity" type="number" class="form-input" placeholder="e.g. 500" />
                        <span asp-validation-for="Capacity" class="field-error"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Amenities" class="form-label"></label>
                    <input asp-for="Amenities" class="form-input" placeholder="AC, Sound System, Catering, Parking (comma-separated)" />
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="ImageFile" class="form-label"></label>
                        <input asp-for="ImageFile" type="file" class="form-input" accept="image/*" />
                        @if (!string.IsNullOrEmpty(Model.ExistingImageUrl))
                        {
                            <img src="@Model.ExistingImageUrl" alt="Current Image" class="preview-img" />
                            <input type="hidden" asp-for="ExistingImageUrl" />
                        }
                    </div>
                    <div class="form-group">
                        <div class="form-check-group">
                            <label class="form-check"><input asp-for="IsAvailable" type="checkbox" /><span>Available for Booking</span></label>
                            <label class="form-check"><input asp-for="IsFeatured" type="checkbox" /><span>Featured on Homepage</span></label>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Halls" class="btn-outline-sm">Cancel</a>
                    <button type="submit" class="btn-primary">@(isEdit ? "Update Hall" : "Create Hall")</button>
                </div>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
