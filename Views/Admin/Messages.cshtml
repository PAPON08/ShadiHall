@model List<ShadiHall.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Messages";
}
<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <div class="dash-profile"><div class="dash-avatar">A</div><div class="dash-profile-info"><strong>Administrator</strong></div></div>
        <nav class="dash-nav">
            <a asp-controller="Admin" asp-action="Index" class="dash-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Halls" class="dash-nav-link"><i class="fas fa-building"></i> Manage Halls</a>
            <a asp-controller="Admin" asp-action="Reservations" class="dash-nav-link"><i class="fas fa-calendar-check"></i> Reservations</a>
            <a asp-controller="Admin" asp-action="Users" class="dash-nav-link"><i class="fas fa-users"></i> Users</a>
            <a asp-controller="Admin" asp-action="Messages" class="dash-nav-link active"><i class="fas fa-envelope"></i> Messages</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dash-page-header"><h1>Contact Messages</h1></div>
        <div class="messages-full-list">
            @foreach (var m in Model)
            {
                <div class="message-full-card @(!m.IsRead ? "unread" : "")">
                    <div class="message-full-header">
                        <div>
                            <strong>@m.FullName</strong>
                            <span>@m.Email</span>
                            @if (!string.IsNullOrEmpty(m.Phone)) { <span>| @m.Phone</span> }
                        </div>
                        <div class="message-full-time">@m.SentAt.ToString("dd MMM yyyy, HH:mm")</div>
                    </div>
                    <div class="message-full-subject">Subject: @m.Subject</div>
                    <div class="message-full-body">@m.Message</div>
                    <div class="message-full-actions">
                        @if (!m.IsRead)
                        {
                            <form asp-action="MarkMessageRead" method="post" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@m.MessageId" />
                                <button class="btn-table btn-edit"><i class="fas fa-check"></i> Mark Read</button>
                            </form>
                        }
                        <form asp-action="DeleteMessage" method="post" style="display:inline;" onsubmit="return confirm('Delete this message?')">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@m.MessageId" />
                            <button class="btn-table btn-delete"><i class="fas fa-trash"></i> Delete</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
