@model List<ShadiHall.Models.Hall>
@{
    ViewData["Title"] = "Manage Halls";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <div class="dash-profile"><div class="dash-avatar">A</div><div class="dash-profile-info"><strong>Administrator</strong></div></div>
        <nav class="dash-nav">
            <a asp-controller="Admin" asp-action="Index" class="dash-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Halls" class="dash-nav-link active"><i class="fas fa-building"></i> Manage Halls</a>
            <a asp-controller="Admin" asp-action="Reservations" class="dash-nav-link"><i class="fas fa-calendar-check"></i> Reservations</a>
            <a asp-controller="Admin" asp-action="Users" class="dash-nav-link"><i class="fas fa-users"></i> Users</a>
            <a asp-controller="Admin" asp-action="Messages" class="dash-nav-link"><i class="fas fa-envelope"></i> Messages</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dash-page-header">
            <h1>Manage Halls</h1>
            <a asp-action="CreateHall" class="btn-primary btn-sm">+ Add Hall</a>
        </div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Image</th><th>Name</th><th>Price/Day</th><th>Capacity</th><th>Status</th><th>Featured</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var h in Model)
                    {
                        <tr>
                            <td><img src="@h.ImageUrl" alt="@h.Name" class="table-thumb" onerror="this.src='/images/default-hall.svg'" /></td>
                            <td><strong>@h.Name</strong><br/><small>@h.Location</small></td>
                            <td>৳@h.PricePerDay.ToString("N0")</td>
                            <td>@h.Capacity</td>
                            <td><span class="status-badge @(h.IsAvailable ? "status-confirmed" : "status-cancelled")">@(h.IsAvailable ? "Available" : "Unavailable")</span></td>
                            <td>@(h.IsFeatured ? "⭐ Yes" : "No")</td>
                            <td class="table-actions">
                                <a asp-action="EditHall" asp-route-id="@h.HallId" class="btn-table btn-edit"><i class="fas fa-edit"></i> Edit</a>
                                <form asp-action="DeleteHall" method="post" style="display:inline;" onsubmit="return confirm('Delete this hall?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@h.HallId" />
                                    <button class="btn-table btn-delete"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
