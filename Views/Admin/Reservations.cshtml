@model List<ShadiHall.Models.Reservation>
@{
    ViewData["Title"] = "Manage Reservations";
}
<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <div class="dash-profile"><div class="dash-avatar">A</div><div class="dash-profile-info"><strong>Administrator</strong></div></div>
        <nav class="dash-nav">
            <a asp-controller="Admin" asp-action="Index" class="dash-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Halls" class="dash-nav-link"><i class="fas fa-building"></i> Manage Halls</a>
            <a asp-controller="Admin" asp-action="Reservations" class="dash-nav-link active"><i class="fas fa-calendar-check"></i> Reservations</a>
            <a asp-controller="Admin" asp-action="Users" class="dash-nav-link"><i class="fas fa-users"></i> Users</a>
            <a asp-controller="Admin" asp-action="Messages" class="dash-nav-link"><i class="fas fa-envelope"></i> Messages</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dash-page-header"><h1>All Reservations</h1></div>

        <!-- Filter by status -->
        <div class="filter-tabs">
            <a asp-action="Reservations" class="filter-tab @(ViewBag.CurrentStatus == null ? "active" : "")">All</a>
            @foreach (var s in Enum.GetValues<ShadiHall.Models.ReservationStatus>())
            {
                <a asp-action="Reservations" asp-route-status="@s" class="filter-tab @(ViewBag.CurrentStatus == s.ToString() ? "active" : "")">@s</a>
            }
        </div>

        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Code</th><th>Hall</th><th>Customer</th><th>Event Date</th><th>Slot</th><th>Amount</th><th>Payment</th><th>Status</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td><strong>#@r.ReservationCode</strong></td>
                            <td>@r.Hall?.Name</td>
                            <td>@r.User?.FullName<br/><small>@r.GuestPhone</small></td>
                            <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                            <td>@r.TimeSlot</td>
                            <td>৳@r.TotalAmount.ToString("N0")</td>
                            <td><span class="status-badge status-@r.PaymentStatus.ToString().ToLower()">@r.PaymentStatus</span></td>
                            <td>
                                <form asp-action="UpdateReservationStatus" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ReservationId" />
                                    <select name="status" class="select-sm" onchange="this.form.submit()">
                                        @foreach (var s in Enum.GetValues<ShadiHall.Models.ReservationStatus>())
                                        {
                                            if (r.Status == s)
                                            {
                                                <option value="@s" selected>@s</option>
                                            }
                                            else
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        }
                                    </select>
                                </form>
                            </td>
                            <td>
                                <form asp-action="DeleteReservation" method="post" onsubmit="return confirm('Delete this reservation?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@r.ReservationId" />
                                    <button class="btn-table btn-delete"><i class="fas fa-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
