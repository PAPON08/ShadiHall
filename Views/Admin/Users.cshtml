@model List<ShadiHall.Models.ApplicationUser>
@{
    ViewData["Title"] = "Manage Users";
    var userRoles = ViewBag.UserRoles as Dictionary<string, IList<string>> ?? new();
}
<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <div class="dash-profile"><div class="dash-avatar">A</div><div class="dash-profile-info"><strong>Administrator</strong></div></div>
        <nav class="dash-nav">
            <a asp-controller="Admin" asp-action="Index" class="dash-nav-link"><i class="fas fa-tachometer-alt"></i> Dashboard</a>
            <a asp-controller="Admin" asp-action="Halls" class="dash-nav-link"><i class="fas fa-building"></i> Manage Halls</a>
            <a asp-controller="Admin" asp-action="Reservations" class="dash-nav-link"><i class="fas fa-calendar-check"></i> Reservations</a>
            <a asp-controller="Admin" asp-action="Users" class="dash-nav-link active"><i class="fas fa-users"></i> Users</a>
            <a asp-controller="Admin" asp-action="Messages" class="dash-nav-link"><i class="fas fa-envelope"></i> Messages</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dash-page-header"><h1>All Users</h1></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Phone</th><th>Role</th><th>Last Login</th><th>Joined</th></tr></thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td><strong>@u.FullName</strong></td>
                            <td>@u.UserName</td>
                            <td>@u.Email</td>
                            <td>@u.PhoneNumber</td>
                            <td>
                                @if (userRoles.TryGetValue(u.Id, out var roles))
                                {
                                    @foreach (var r in roles) { <span class="role-badge">@r</span> }
                                }
                            </td>
                            <td>@(u.LastLogin?.ToString("dd MMM yyyy HH:mm") ?? "Never")</td>
                            <td>@u.CreatedAt.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
