@model ShadiHall.ViewModels.HallDetailsViewModel
@{
    ViewData["Title"] = Model.Hall.Name;
}

<div class="detail-page">
    <div class="detail-container">

        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <span>/</span>
            <a asp-controller="Hall" asp-action="Index">Halls</a>
            <span>/</span>
            <span>@Model.Hall.Name</span>
        </nav>

        <div class="detail-grid">
            <!-- Left: Image & Info -->
            <div class="detail-main">
                <div class="detail-img-wrap">
                    <img src="@Model.Hall.ImageUrl" alt="@Model.Hall.Name" class="detail-img" onerror="this.src='/images/default-hall.svg'" />
                    @if (!Model.Hall.IsAvailable)
                    {
                        <div class="detail-unavailable-overlay">Currently Unavailable</div>
                    }
                </div>

                <div class="detail-body">
                    <h1 class="detail-title">@Model.Hall.Name</h1>

                    <div class="detail-meta-row">
                        <span><i class="fas fa-map-marker-alt"></i> @Model.Hall.Location</span>
                        <span><i class="fas fa-users"></i> Up to @Model.Hall.Capacity guests</span>
                        @if (Model.ReviewCount > 0)
                        {
                            <span>
                                <i class="fas fa-star star-filled"></i>
                                @Model.AverageRating.ToString("0.0") (@Model.ReviewCount reviews)
                            </span>
                        }
                    </div>

                    <div class="detail-description">
                        <h3>About This Hall</h3>
                        <p>@Model.Hall.Description</p>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.Hall.Amenities))
                    {
                        <div class="detail-amenities">
                            <h3>Amenities</h3>
                            <div class="amenities-list">
                                @foreach (var amenity in Model.Hall.Amenities.Split(','))
                                {
                                    <span class="amenity-tag"><i class="fas fa-check"></i> @amenity.Trim()</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Booking Card -->
            <div class="detail-sidebar">
                <div class="booking-card">
                    <div class="booking-price">
                        <span class="booking-price-label">Starting from</span>
                        <div class="booking-price-main">
                            <span class="booking-currency">৳</span>
                            <span class="booking-amount">@Model.Hall.PricePerDay.ToString("N0")</span>
                        </div>
                        <span class="booking-price-unit">per day (12 hours)</span>
                        <div class="booking-price-note">6-hour slot: ৳@((Model.Hall.PricePerDay * 0.6m).ToString("N0"))</div>
                    </div>

                    @if (Model.Hall.IsAvailable)
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Reservation" asp-action="Create" asp-route-hallId="@Model.Hall.HallId"
                               class="btn-primary btn-full">
                                <i class="fas fa-calendar-check"></i> Reserve This Hall
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Reservation/Create?hallId=@Model.Hall.HallId"
                               class="btn-primary btn-full">
                                <i class="fas fa-lock"></i> Login to Reserve
                            </a>
                        }
                    }
                    else
                    {
                        <button class="btn-disabled btn-full" disabled>Currently Unavailable</button>
                    }

                    <div class="booking-info">
                        <div class="booking-info-item"><i class="fas fa-shield-alt"></i> Secure booking guaranteed</div>
                        <div class="booking-info-item"><i class="fas fa-undo"></i> Free cancellation available</div>
                        <div class="booking-info-item"><i class="fas fa-headset"></i> 24/7 support</div>
                    </div>
                </div>

                <div class="contact-card">
                    <h4>Need Help?</h4>
                    <p>Call us: <strong>+880-1700-000000</strong></p>
                    <a asp-controller="Home" asp-action="Contact" class="btn-outline-sm btn-full">Send Enquiry</a>
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="reviews-section">
            <h2 class="reviews-heading">
                <i class="fas fa-star star-filled"></i>
                Reviews & Ratings
                @if (Model.ReviewCount > 0)
                {
                    <span class="reviews-count">(@Model.ReviewCount reviews, avg @Model.AverageRating.ToString("0.0")★)</span>
                }
            </h2>

            <!-- Review Form -->
            @if (User.Identity?.IsAuthenticated == true && !Model.UserHasReviewed)
            {
                <div class="review-form-wrap">
                    <h3>Write a Review</h3>
                    <form asp-controller="Hall" asp-action="SubmitReview" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="HallId" value="@Model.Hall.HallId" />
                        <div class="form-group">
                            <label>Rating</label>
                            <div class="star-rating-input" id="starRatingInput">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="fas fa-star star-input" data-value="@i"></i>
                                }
                                <input type="hidden" name="Rating" id="ratingValue" value="0" required />
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="comment">Your Review</label>
                            <textarea name="Comment" id="comment" class="form-input" rows="4" placeholder="Share your experience..." required minlength="10"></textarea>
                        </div>
                        <button type="submit" class="btn-primary">Submit Review</button>
                    </form>
                </div>
            }
            else if (User.Identity?.IsAuthenticated == true && Model.UserHasReviewed)
            {
                <div class="review-notice"><i class="fas fa-check-circle"></i> You have already reviewed this hall.</div>
            }
            else
            {
                <div class="review-notice">
                    <a asp-controller="Account" asp-action="Login">Login</a> to write a review.
                </div>
            }

            <!-- Reviews List -->
            @if (!Model.Reviews.Any())
            {
                <div class="empty-state"><i class="fas fa-comment-slash"></i><p>No reviews yet. Be the first to review!</p></div>
            }
            else
            {
                <div class="reviews-list">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review-item">
                            <div class="review-item-header">
                                <div class="review-avatar-sm">@(review.User?.FullName?.Substring(0, 1).ToUpper() ?? "U")</div>
                                <div class="review-item-meta">
                                    <strong>@(review.User?.FullName ?? "Guest")</strong>
                                    <span>@review.CreatedAt.ToString("MMMM dd, yyyy")</span>
                                </div>
                                <div class="review-stars-sm">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= review.Rating ? "star-filled" : "star-empty")"></i>
                                    }
                                </div>
                            </div>
                            <p class="review-item-text">@review.Comment</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Star rating input
        const stars = document.querySelectorAll('.star-input');
        const ratingInput = document.getElementById('ratingValue');
        if (ratingInput) {
            stars.forEach(star => {
                star.addEventListener('click', function () {
                    const val = parseInt(this.dataset.value);
                    ratingInput.value = val;
                    stars.forEach((s, i) => s.classList.toggle('star-filled', i < val));
                });
                star.addEventListener('mouseover', function () {
                    const val = parseInt(this.dataset.value);
                    stars.forEach((s, i) => s.classList.toggle('star-hover', i < val));
                });
                star.addEventListener('mouseout', function () {
                    stars.forEach(s => s.classList.remove('star-hover'));
                });
            });
        }
    </script>
}
