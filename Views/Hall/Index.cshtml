@model ShadiHall.ViewModels.HallListViewModel
@{
    ViewData["Title"] = "Halls & Services";
}

<div class="page-hero page-hero-sm">
    <div class="page-hero-content">
        <h1>Halls & Services</h1>
        <p>Find the perfect venue for your celebration</p>
    </div>
</div>

<section class="halls-section">
    <div class="section-container">

        <!-- Filters -->
        <form method="get" asp-action="Index" class="filter-form">
            <div class="filter-grid">
                <div class="filter-field">
                    <label>Search</label>
                    <input type="text" name="search" value="@Model.SearchTerm" placeholder="Hall name or keyword..." class="form-input" />
                </div>
                <div class="filter-field">
                    <label>Min Price (৳)</label>
                    <input type="number" name="minPrice" value="@Model.MinPrice" placeholder="0" class="form-input" />
                </div>
                <div class="filter-field">
                    <label>Max Price (৳)</label>
                    <input type="number" name="maxPrice" value="@Model.MaxPrice" placeholder="500000" class="form-input" />
                </div>
                <div class="filter-field">
                    <label>Min Capacity</label>
                    <input type="number" name="minCapacity" value="@Model.MinCapacity" placeholder="50" class="form-input" />
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn-primary">Search</button>
                    <a asp-action="Index" class="btn-outline-sm">Clear</a>
                </div>
            </div>
        </form>

        <!-- Results Count -->
        <div class="results-meta">
            <p>Showing <strong>@Model.Halls.Count</strong> of <strong>@Model.TotalCount</strong> halls</p>
        </div>

        @if (!Model.Halls.Any())
        {
            <div class="empty-state">
                <i class="fas fa-search"></i>
                <h3>No halls found</h3>
                <p>Try adjusting your search or filters.</p>
                <a asp-action="Index" class="btn-primary">View All Halls</a>
            </div>
        }
        else
        {
            <!-- Hall Grid -->
            <div class="halls-grid">
                @foreach (var hall in Model.Halls)
                {
                    <div class="hall-card">
                        <div class="hall-card-img">
                            <img src="@hall.ImageUrl" alt="@hall.Name" onerror="this.src='/images/default-hall.svg'" />
                            @if (hall.IsFeatured) { <span class="hall-badge">Featured</span> }
                            @if (!hall.IsAvailable) { <span class="hall-badge badge-unavailable">Unavailable</span> }
                        </div>
                        <div class="hall-card-body">
                            <h3 class="hall-card-title">@hall.Name</h3>
                            <p class="hall-card-desc">@hall.ShortDescription</p>
                            <div class="hall-card-meta">
                                <span><i class="fas fa-users"></i> Up to @hall.Capacity</span>
                                <span><i class="fas fa-map-marker-alt"></i> @hall.Location</span>
                            </div>
                            @if (!string.IsNullOrEmpty(hall.Amenities))
                            {
                                <div class="hall-amenities">
                                    @foreach (var amenity in hall.Amenities.Split(',').Take(4))
                                    {
                                        <span class="amenity-tag">@amenity.Trim()</span>
                                    }
                                </div>
                            }
                            <div class="hall-card-footer">
                                <div class="hall-price">
                                    <span class="price-label">From</span>
                                    <span class="price-amount">৳@hall.PricePerDay.ToString("N0")</span>
                                    <span class="price-unit">/day</span>
                                </div>
                                <a asp-controller="Hall" asp-action="Details" asp-route-id="@hall.HallId" class="btn-card">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination">
                    @if (Model.CurrentPage > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-search="@Model.SearchTerm" class="page-btn">
                            <i class="fas fa-chevron-left"></i>
                        </a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <a asp-action="Index" asp-route-page="@i" asp-route-search="@Model.SearchTerm"
                           class="page-btn @(i == Model.CurrentPage ? "page-btn-active" : "")">@i</a>
                    }
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-search="@Model.SearchTerm" class="page-btn">
                            <i class="fas fa-chevron-right"></i>
                        </a>
                    }
                </div>
            }
        }
    </div>
</section>
