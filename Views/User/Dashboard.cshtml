@model ShadiHall.ViewModels.UserDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
}

<div class="dashboard-layout">
    <!-- Sidebar -->
    <aside class="dashboard-sidebar">
        <div class="dash-profile">
            <div class="dash-avatar">@Model.User.FullName.Substring(0, 1).ToUpper()</div>
            <div class="dash-profile-info">
                <strong>@Model.User.FullName</strong>
                <span>@Model.User.Email</span>
            </div>
        </div>
        <nav class="dash-nav">
            <a href="#reservations" class="dash-nav-link active"><i class="fas fa-calendar-check"></i> My Reservations</a>
            <a href="#profile" class="dash-nav-link"><i class="fas fa-user-edit"></i> Edit Profile</a>
            <a href="#password" class="dash-nav-link"><i class="fas fa-key"></i> Change Password</a>
            <a asp-controller="Hall" asp-action="Index" class="dash-nav-link"><i class="fas fa-building"></i> Browse Halls</a>
            <a asp-controller="Account" asp-action="Logout" class="dash-nav-link dash-logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="dashboard-main">
        <!-- Stats -->
        <div class="dash-stats">
            <div class="dash-stat-card">
                <i class="fas fa-calendar-alt"></i>
                <div>
                    <span class="dash-stat-num">@Model.TotalReservations</span>
                    <span class="dash-stat-label">Total Reservations</span>
                </div>
            </div>
            <div class="dash-stat-card">
                <i class="fas fa-check-circle"></i>
                <div>
                    <span class="dash-stat-num">@Model.ActiveReservations</span>
                    <span class="dash-stat-label">Active</span>
                </div>
            </div>
            <div class="dash-stat-card">
                <i class="fas fa-times-circle"></i>
                <div>
                    <span class="dash-stat-num">@Model.CancelledReservations</span>
                    <span class="dash-stat-label">Cancelled</span>
                </div>
            </div>
        </div>

        <!-- Reservations Table -->
        <div class="dash-section" id="reservations">
            <div class="dash-section-header">
                <h2>My Reservations</h2>
                <a asp-controller="Hall" asp-action="Index" class="btn-primary btn-sm">+ New Reservation</a>
            </div>

            @if (!Model.Reservations.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-calendar-times"></i>
                    <h3>No reservations yet</h3>
                    <p>Start by browsing our available halls.</p>
                    <a asp-controller="Hall" asp-action="Index" class="btn-primary">Browse Halls</a>
                </div>
            }
            else
            {
                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Reservation ID</th>
                                <th>Hall</th>
                                <th>Event Date</th>
                                <th>Time Slot</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.Reservations)
                            {
                                <tr>
                                    <td><strong>#@r.ReservationCode</strong></td>
                                    <td>@r.Hall?.Name</td>
                                    <td>@r.EventDate.ToString("dd MMM yyyy")</td>
                                    <td>@r.TimeSlot</td>
                                    <td>৳@r.TotalAmount.ToString("N0")</td>
                                    <td>
                                        <span class="status-badge status-@r.Status.ToString().ToLower()">@r.Status</span>
                                    </td>
                                    <td class="table-actions">
                                        @if (r.Status == ShadiHall.Models.ReservationStatus.Pending)
                                        {
                                            <a asp-controller="Reservation" asp-action="Edit" asp-route-id="@r.ReservationId" class="btn-table btn-edit">
                                                <i class="fas fa-edit"></i> Edit
                                            </a>
                                            <form asp-controller="Reservation" asp-action="Cancel" method="post" style="display:inline;"
                                                  onsubmit="return confirm('Cancel this reservation?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@r.ReservationId" />
                                                <button type="submit" class="btn-table btn-delete"><i class="fas fa-times"></i> Cancel</button>
                                            </form>
                                        }
                                        <a asp-controller="Reservation" asp-action="Confirmation" asp-route-id="@r.ReservationId" class="btn-table btn-view">
                                            <i class="fas fa-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- Edit Profile -->
        <div class="dash-section" id="profile">
            <h2>Edit Profile</h2>
            <form asp-controller="User" asp-action="EditProfile" method="post" class="form-card">
                @Html.AntiForgeryToken()
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <input type="text" name="fullName" value="@Model.User.FullName" class="form-input" required />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone Number</label>
                        <input type="text" name="phoneNumber" value="@Model.User.PhoneNumber" class="form-input" />
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <input type="text" name="address" value="@Model.User.Address" class="form-input" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email (Read-only)</label>
                    <input type="text" value="@Model.User.Email" class="form-input" disabled />
                </div>
                <button type="submit" class="btn-primary">Save Profile</button>
            </form>
        </div>

        <!-- Change Password -->
        <div class="dash-section" id="password">
            <h2>Change Password</h2>
            <form asp-controller="User" asp-action="ChangePassword" method="post" class="form-card">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary"></div>
                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <input type="password" name="currentPassword" class="form-input" required />
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <input type="password" name="newPassword" class="form-input" required minlength="8" />
                    </div>
                    <div class="form-group">
                        <label class="form-label">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="form-input" required />
                    </div>
                </div>
                <button type="submit" class="btn-primary">Update Password</button>
            </form>
        </div>
    </main>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
