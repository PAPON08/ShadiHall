@{
    ViewData["Title"] = "Change Password";
}

<div class="page-hero page-hero-sm">
    <div class="page-hero-content">
        <h1>Change Password</h1>
        <p>Keep your account secure</p>
    </div>
</div>

<section class="form-section">
    <div class="form-container" style="max-width:520px;">
        <div class="form-card">
            <h2 class="form-card-title"><i class="fas fa-key"></i> Update Password</h2>

            <form asp-action="ChangePassword" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary"></div>

                <div class="form-group">
                    <label class="form-label">Current Password</label>
                    <div class="input-icon-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" name="currentPassword" class="form-input input-with-icon"
                               placeholder="Enter current password" id="currentPw" required />
                        <button type="button" class="input-icon-right" onclick="togglePass('currentPw',this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <div class="input-icon-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" name="newPassword" class="form-input input-with-icon"
                               placeholder="Min 8 characters" id="newPw" required minlength="8" />
                        <button type="button" class="input-icon-right" onclick="togglePass('newPw',this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <small class="form-hint">Must include uppercase, lowercase, number &amp; special character.</small>
                </div>

                <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <div class="input-icon-wrap">
                        <i class="fas fa-lock input-icon"></i>
                        <input type="password" name="confirmPassword" class="form-input input-with-icon"
                               placeholder="Re-enter new password" id="confirmPw" required />
                        <button type="button" class="input-icon-right" onclick="togglePass('confirmPw',this)">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-controller="User" asp-action="Dashboard" class="btn-outline-sm">Cancel</a>
                    <button type="submit" class="btn-primary">Update Password</button>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
    function togglePass(id, btn) {
        const f = document.getElementById(id);
        const icon = btn.querySelector('i');
        if (f.type === 'password') { f.type = 'text'; icon.className = 'fas fa-eye-slash'; }
        else { f.type = 'password'; icon.className = 'fas fa-eye'; }
    }
</script>
}
